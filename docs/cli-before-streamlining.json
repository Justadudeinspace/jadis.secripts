      "operations": [
        "github.auth",
        "github.repository",
        "github.workflows"
      ]
    },
    "python-dev": {
      "title": "Python development health",
      "summary": "Inspect interpreter isolation, project metadata, editables and dependency consistency.",
      "operations": [
        "python.environment",
        "python.project",
        "python.editables",
        "python.dependencies"
      ]
    },
    "android-sdk-health": {
      "title": "Android SDK health",
      "summary": "Inspect SDK components and Java, then platform-tool versions without license acceptance.",
      "operations": [
        "android.sdk.validate",
        "java.environment",
        "adb.version",
        "fastboot.version"
      ]
    },
    "adb-diagnostics": {
      "title": "ADB diagnostics",
      "summary": "Inspect client and sanitized transports; no device shell commands.",
      "operations": [
        "adb.version",
        "adb.devices"
      ]
    },
    "fastboot-diagnostics": {
      "title": "Fastboot diagnostics",
